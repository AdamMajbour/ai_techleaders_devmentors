{
  "name": "devmentor",
  "version": "0.1.0",
  "description": "Platform for mentorship and programming skill development",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm --workspace=@devmentor/app run dev --",
    "build": "npm run type-check && npm --workspace=@devmentor/app run build",
    "start": "npm --workspace=@devmentor/app run start --",
    "lint": "eslint packages",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "jest --selectProjects unit",
    "test:agent-scripts": "node --test .agents/skills/om-auto-issue-triage/scripts/select-issues.test.mjs .agents/skills/om-auto-merge-buddy/scripts/dashboard.test.mjs",
    "test:watch": "jest --watch",
    "migrate": "npm --workspace=@devmentor/db run migrate",
    "migrate:down": "npm --workspace=@devmentor/db run migrate:down",
    "db:up": "node scripts/db-up.mjs",
    "db:migrate": "npm run migrate",
    "db:seed": "npm --workspace=@devmentor/db run seed",
    "db:seed:text-sessions": "npm --workspace=@devmentor/db run seed:text-sessions",
    "db:seed:lesson-14": "npm --workspace=@devmentor/db run seed:lesson-14",
    "pilot:invite": "npm --workspace=@devmentor/core run pilot:invite --",
    "invite": "npm --workspace=@devmentor/core run pilot:invite --",
    "bookings:settle": "npm --workspace=@devmentor/core run bookings:settle --",
    "vault:settle": "npm --workspace=@devmentor/core run vault:settle --",
    "retention:sweep": "npm --workspace=@devmentor/core run retention:sweep --",
    "test:integration": "jest --selectProjects db",
    "test:all": "jest",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:browser:install": "playwright install chromium",
    "audit:prod": "npm audit --omit=dev --audit-level=critical",
    "check:agents": "node .ai/scripts/validate-task-router.js"
  },
  "devDependencies": {
    "@size-limit/file": "^14.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "playwright": "^1.64.1",
    "size-limit": "^14.3.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5"
  }
}
