{
  "name": "devmentor",
  "version": "0.1.0",
  "description": "Platform for mentorship and programming skill development",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=packages/app run dev",
    "build": "npm run build --workspaces",
    "start": "npm --workspace=packages/app run start",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "npm --workspace=packages/db run migrate",
    "migrate:down": "npm --workspace=packages/db run migrate:down",
    "db:seed": "npm --workspace=packages/db run seed"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "typescript": "^5"
  }
}
