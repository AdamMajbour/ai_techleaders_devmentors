{
  "name": "@devmentor/ui",
  "version": "1.0.2",
  "description": "Reusable UI components with shadcn-ui and Tailwind CSS",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/index.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./time": "./src/time/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "tokens:contrast": "node scripts/contrast.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "storybook": "node scripts/contrast.mjs && storybook dev -p 6006 --no-open --no-version-updates --disable-telemetry",
    "build-storybook": "node scripts/contrast.mjs && storybook build --disable-telemetry",
    "test:stories": "node scripts/test-stories.mjs",
    "test:stories:jsdom": "vitest run --config vitest.jsdom.config.mts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1",
    "@radix-ui/react-dropdown-menu": "^2.1",
    "@radix-ui/react-slot": "^1.2",
    "class-variance-authority": "^0.7",
    "clsx": "^2.1",
    "lucide-react": "^1.62.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^5.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
