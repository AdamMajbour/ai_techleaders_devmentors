{
  "name": "@devmentor/db",
  "version": "0.1.0",
  "description": "Database layer with MikroORM entities, migrations, and repositories",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "migrate": "mikro-orm migration:up",
    "migrate:down": "mikro-orm migration:down",
    "migration:create": "mikro-orm migration:create",
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@devmentor/core": "*",
    "mikro-orm": "^5.9",
    "@mikro-orm/postgresql": "^5.9",
    "@mikro-orm/migrations": "^5.9",
    "pg": "^8.12",
    "class-validator": "^0.14",
    "class-transformer": "^0.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
