{
  "name": "@devmentor/db",
  "version": "0.1.0",
  "description": "Database layer with MikroORM entities, migrations, and repositories",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "migrate": "mikro-orm migration:up",
    "migrate:down": "mikro-orm migration:down",
    "migration:create": "mikro-orm migration:create",
    "seed": "ts-node scripts/seed.ts",
    "seed:lesson-14": "ts-node scripts/seed-lesson-14.ts",
    "seed:lesson-16-session": "ts-node scripts/seed-lesson-16-session.ts"
  },
  "mikro-orm": {
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/postgresql": "^6",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6",
    "@types/node": "^20",
    "ts-node": "^10",
    "typescript": "^5"
  }
}
