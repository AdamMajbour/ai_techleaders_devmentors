{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "jsx": "preserve",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "mikro-orm.config.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node"
    }
  }
}
