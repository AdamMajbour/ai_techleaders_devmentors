{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./.next/static",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@devmentor/core": ["../core/src/index.ts"],
      "@devmentor/core/*": ["../core/src/*"],
      "@devmentor/db": ["../db/src/index.ts"],
      "@devmentor/db/*": ["../db/src/*"],
      "@devmentor/ui": ["../ui/src/index.ts"],
      "@devmentor/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
