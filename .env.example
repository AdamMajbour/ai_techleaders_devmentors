# Copy to .env.local (not committed). Read by the MikroORM CLI (npm run migrate) and the seed script.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=devmentor
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Session signing key (HS256). At least 32 random bytes; generate with: openssl rand -base64 48
# Required by the auth routes only; the app builds and boots without it.
JWT_SECRET=

# Local seed operator only. Replace with explicitly approved operator IDs for deployment.
OPERATOR_USER_IDS=7bb1d923-bf91-4fd2-868b-d03526fe829e

# Invitation-only pilot sign-in; set false to close password-based public registration.
PUBLIC_SIGNUP=false

# Public application origin used to build sign-in links (never derived from request Host).
APP_BASE_URL=http://localhost:3000

# Optional GitHub OAuth App. Callback URL: {APP_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=Ov23liBnyNtiF7JeMigr
GITHUB_CLIENT_SECRET=9b445b1bf7daf2400b1a0b9fad6d3868fa4b9926
# Verified GitHub e-mails mapped to the three seeded demo roles (leave empty to disable role-specific GitHub sign-in).
DEMO_MENTEE_GITHUB_EMAIL=
DEMO_MENTOR_GITHUB_EMAIL=
DEMO_OPERATOR_GITHUB_EMAIL=

# Paid bookings expire after this many minutes without a mentor response.
MENTOR_RESPONSE_WINDOW_MINUTES=120
VAULT_PUBLISH_ENABLED=false
VAULT_PUBLISH_ENABLED=false
# D25 is not recorded: keep this empty. Supported values, only after approval: mentor_declined,mentor_unresponsive.
REFUND_AUTO_APPROVE_REASONS=

# Mail delivery: console is the development default; http uses Resend's HTTP API.
MAILER_MODE=console
# Required only when MAILER_MODE=http.
MAILER_API_KEY=
MAIL_FROM=

# Payments use the local mock adapter unless Stripe test mode is explicitly selected.
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep live payments disabled until the pilot's explicit launch gate is complete.
PAYMENTS_LIVE_ENABLED=false

# Paid vault answers stay unavailable until live AI is deliberately enabled.
AI_MODE=mock
AI_LIVE_ENABLED=false
AI_ALLOW_MOCK_IN_PRODUCTION=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
